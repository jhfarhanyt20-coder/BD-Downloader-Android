<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only: the app UI itself is drawn by Compose (see ui/theme). -->
    <style name="Theme.VibeDownloader" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vd_bg</item>
        <item name="android:statusBarColor">@color/vd_bg</item>
        <item name="android:navigationBarColor">@color/vd_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The share sheet: see-through, so the app it was shared from stays visible behind it -->
    <style name="Theme.VibeDownloader.Sheet" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
